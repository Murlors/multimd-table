{
  "name": "multimd-table",
  "version": "0.2.2",
  "description": "Parse, render and write MultiMarkdown tables with merged cells, structured data and Markdown ecosystem adapters",
  "keywords": [
    "markdown",
    "multimarkdown",
    "table",
    "merged-cells",
    "rowspan",
    "colspan",
    "parser",
    "serialization",
    "remark",
    "remark-plugin",
    "unified",
    "marked",
    "markdown-it",
    "markdown-it-plugin"
  ],
  "homepage": "https://github.com/Murlors/multimd-table#readme",
  "bugs": {
    "url": "https://github.com/Murlors/multimd-table/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Murlors/multimd-table.git"
  },
  "files": [
    "dist/core.js",
    "dist/core.d.ts",
    "dist/writer.js",
    "dist/writer.d.ts",
    "dist/remark.js",
    "dist/remark.d.ts",
    "dist/marked.js",
    "dist/marked.d.ts",
    "dist/markdown-it.js",
    "dist/markdown-it.d.ts",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./remark": {
      "types": "./dist/remark.d.ts",
      "default": "./dist/remark.js"
    },
    "./writer": {
      "types": "./dist/writer.d.ts",
      "default": "./dist/writer.js"
    },
    "./marked": {
      "types": "./dist/marked.d.ts",
      "default": "./dist/marked.js"
    },
    "./markdown-it": {
      "types": "./dist/markdown-it.d.ts",
      "default": "./dist/markdown-it.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build src/core.ts src/writer.ts src/remark.ts src/marked.ts src/markdown-it.ts --no-bundle --minify --keep-names --format=esm --target=browser --root=src --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test",
    "test:development": "bun --conditions=development test ./test",
    "bench:build": "bun build tooling/benchmark.ts --target=node --packages=external --outfile=.performance/benchmark.mjs",
    "bench": "bun run build && bun run bench:build && bun .performance/benchmark.mjs",
    "bench:compare": "bun run bench:build && bun .performance/benchmark.mjs --compare",
    "check": "bun run typecheck && bun run test && bun run test:development && bun run build",
    "check:package": "bun run build && bun tooling/check-package.ts",
    "prepack": "bun run check",
    "prepublishOnly": "bun run check:package"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "micromark-util-types": "^2.0.2"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "markdown-it": "15.0.2",
    "marked": "18.1.1",
    "mdast-util-from-markdown": "^2.0.2",
    "parse5": "^7.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.9.3",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "mdast-util-from-markdown": "^2.0.0",
    "unified": "^11.0.0",
    "marked": "^18.0.0",
    "markdown-it": "^15.0.0"
  },
  "peerDependenciesMeta": {
    "unified": {
      "optional": true
    },
    "mdast-util-from-markdown": {
      "optional": true
    },
    "marked": {
      "optional": true
    },
    "markdown-it": {
      "optional": true
    }
  }
}

{
  "name": "multimd-table",
  "version": "0.1.0-beta.1",
  "description": "Parser-independent MultiMarkdown tables with a native remark adapter",
  "homepage": "https://github.com/Murlors/multimd-table#readme",
  "bugs": {
    "url": "https://github.com/Murlors/multimd-table/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Murlors/multimd-table.git"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./remark": {
      "types": "./dist/remark.d.ts",
      "default": "./dist/remark.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "beta"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test",
    "test:development": "bun --conditions=development test ./test",
    "check": "bun run typecheck && bun run test && bun run test:development && bun run build",
    "check:package": "bun run build && bun tooling/check-package.ts",
    "prepack": "bun run check",
    "prepublishOnly": "bun run check:package"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "micromark-util-types": "^2.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "markdown-it": "13.0.2",
    "markdown-it-multimd-table": "4.2.3",
    "mdast-util-from-markdown": "^2.0.2",
    "parse5": "^7.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.9.3",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "mdast-util-from-markdown": "^2.0.0",
    "unified": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "unified": {
      "optional": true
    },
    "mdast-util-from-markdown": {
      "optional": true
    }
  }
}

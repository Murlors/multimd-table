{
  "name": "multimd-table",
  "version": "0.4.0",
  "description": "Parse, render and write MultiMarkdown tables with merged cells, structured data and Markdown ecosystem adapters",
  "keywords": [
    "colspan",
    "markdown",
    "markdown-it",
    "markdown-it-plugin",
    "marked",
    "merged-cells",
    "multimarkdown",
    "parser",
    "remark",
    "remark-plugin",
    "rowspan",
    "serialization",
    "table",
    "unified"
  ],
  "homepage": "https://github.com/Murlors/multimd-table#readme",
  "bugs": {
    "url": "https://github.com/Murlors/multimd-table/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Murlors/multimd-table.git",
    "directory": "packages/js"
  },
  "files": [
    "dist/core.js",
    "dist/core.d.ts",
    "dist/writer.js",
    "dist/writer.d.ts",
    "dist/remark.js",
    "dist/remark.d.ts",
    "dist/marked.js",
    "dist/marked.d.ts",
    "dist/markdown-it.js",
    "dist/markdown-it.d.ts",
    "dist/types.d.ts",
    "dist/internal/backend.js",
    "dist/internal/loader.js",
    "dist/internal/wasm.mjs",
    "dist/internal/wire.mjs",
    "dist/internal/core.wasm",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./remark": {
      "types": "./dist/remark.d.ts",
      "default": "./dist/remark.js"
    },
    "./writer": {
      "types": "./dist/writer.d.ts",
      "default": "./dist/writer.js"
    },
    "./marked": {
      "types": "./dist/marked.d.ts",
      "default": "./dist/marked.js"
    },
    "./markdown-it": {
      "types": "./dist/markdown-it.d.ts",
      "default": "./dist/markdown-it.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  },
  "scripts": {
    "prepack": "vp check && vp test && vp run verify:package",
    "verify:package": "vp pack && bun tooling/check-package.ts",
    "bench": "vp pack && bun tooling/benchmark.ts",
    "bench:compare": "bun tooling/benchmark.ts --compare"
  },
  "dependencies": {
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "micromark-util-types": "^2.0.2"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@mdx-js/mdx": "3.1.1",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "markdown-it": "catalog:",
    "marked": "18.1.1",
    "mdast-util-from-markdown": "^2.0.2",
    "parse5": "^7.3.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "peerDependencies": {
    "markdown-it": "^15.0.0",
    "marked": "^18.0.0",
    "mdast-util-from-markdown": "^2.0.0",
    "unified": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "unified": {
      "optional": true
    },
    "mdast-util-from-markdown": {
      "optional": true
    },
    "marked": {
      "optional": true
    },
    "markdown-it": {
      "optional": true
    }
  }
}

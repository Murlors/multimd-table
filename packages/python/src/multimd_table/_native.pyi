from types import TracebackType
from typing import Literal, Self
from .types import Options, Table, WriteTable

def parse_table(
    source: str, *, multiline: bool = False, rowspan: bool = False,
    headerless: bool = False, multibody: bool = True, autolabel: bool = True,
) -> Table | None: ...
def stringify_table(table: Table | WriteTable) -> str: ...
def cell_bounds(line: str) -> list[int]: ...

class TableScanner:
    def __init__(
        self, *, multiline: bool = False, rowspan: bool = False,
        headerless: bool = False, multibody: bool = True, autolabel: bool = True,
    ) -> None: ...
    @property
    def options(self) -> Options: ...
    @property
    def accepted(self) -> bool: ...
    @property
    def committed(self) -> bool: ...
    @property
    def finished(self) -> bool: ...
    @property
    def disposed(self) -> bool: ...
    def push(self, line: str, offset: int) -> bool: ...
    def finish(self) -> Table | None: ...
    def dispose(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self, kind: type[BaseException] | None, value: BaseException | None,
        traceback: TracebackType | None,
    ) -> Literal[False]: ...
